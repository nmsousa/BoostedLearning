<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- System-bar colour used by the app theme (status + navigation bars).
         Matches the default dark "ocean" TOOLBAR (header/footer) colour
         (--ion-toolbar-background: #16263d) so the status bar and the bottom
         navigation/gesture bar blend with the header/footer — on devices (e.g.
         Xiaomi) where the runtime status-bar tint doesn't fully take and
         nothing recolours the nav bar at runtime. The status bar is still
         refined per theme at runtime by @capacitor/status-bar. -->
    <color name="appBackground">#16263D</color>
</resources>
