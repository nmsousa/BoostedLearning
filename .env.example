# Template for the local .env file (which is git-ignored).
# Copy this to .env and fill in your own values:
#   cp .env.example .env   (or just create .env by hand)

# Google Cloud Text-to-Speech API key, used by scripts/gen-audio*.mjs.
# Create one at https://console.cloud.google.com/ → APIs & Services →
# Credentials → Create credentials → API key, then restrict it to the
# "Cloud Text-to-Speech API". The free tier covers this app's usage easily.
GOOGLE_TTS_API_KEY=AIzaABCDEFGHIJKLMN

# Optional: override the TTS voice (defaults to fr-FR-Neural2-A).
# GOOGLE_TTS_VOICE=fr-FR-Neural2-A
